{
  "name": "project-harness",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "project": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun src/main.ts",
    "dev:web": "PROJECT_WEB_DEVELOPMENT=1 bun src/main.ts --web",
    "check": "tsgo --noEmit && tsgo --noEmit -p tsconfig.web.json",
    "verify:omp": "bun scripts/verify-omp.ts",
    "build:omp-native": "bun scripts/record-native.ts",
    "test": "bun test",
    "test:integration": "bun test test/integration.test.ts test/runtime.test.ts test/runtime-input.test.ts",
    "example:runtime": "bun examples/runtime.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "link:@oh-my-pi/pi-coding-agent",
    "@oh-my-pi/pi-natives": "link:@oh-my-pi/pi-natives",
    "@oh-my-pi/pi-tui": "link:@oh-my-pi/pi-tui",
    "@oh-my-pi/pi-utils": "link:@oh-my-pi/pi-utils",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "link:@oh-my-pi/pi-ai",
    "@oh-my-pi/pi-catalog": "link:@oh-my-pi/pi-catalog",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/native-preview": "latest"
  }
}
